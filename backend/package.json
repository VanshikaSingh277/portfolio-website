{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API, content export and local admin panel for the portfolio site",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "admin": "node src/server.js --admin",
    "export": "node src/export.js",
