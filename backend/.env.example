# Copy to backend/.env and fill in. Never commit .env.

# --- Server ---
PORT=5000
# development | production  (the admin panel never runs in production)
NODE_ENV=development
# Comma-separated list of sites allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://vanshikasingh.vercel.app
# Set to 1 when running behind a proxy such as Render, so rate limits see the real client IP
TRUST_PROXY=0

# --- Contact form email (SMTP) ---
# Gmail example: smtp.gmail.com, port 465, SMTP_SECURE=true, and an App Password for SMTP_PASS.
# If SMTP_HOST is empty in development, messages are printed to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address shown on the email (defaults to SMTP_USER)
SMTP_FROM=
# Where contact form messages are delivered
CONTACT_TO=chauhanvanshika277@gmail.com

# --- Local admin panel (http://localhost:5000/admin) ---
# Leave empty to disable. Do NOT set this on Render.
ADMIN_PASSWORD=
